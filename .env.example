# Datalogue Docker Compose 部署配置示例：复制为根目录 .env 后填入真实值。

# 业务 PostgreSQL；已有数据卷时必须使用原密码。
DB_PASSWORD=replace-with-existing-or-strong-postgres-password

# 生产环境必须使用密钥管理系统注入的随机值。
SECRET_KEY=replace-with-random-secret-key
AES_KEY=replace-with-32-byte-aes-key

APP_ENV=production
LOG_LEVEL=INFO
WEB_PORT=3000
NGINX_TLS_HOSTS=localhost,127.0.0.1
DATALOGUE_NETWORK_NAME=datalogue_default

# Phoenix 与 datalogue 数据库共用 PostgreSQL，表位于 phoenix Schema。
PHOENIX_SECRET=replace-with-at-least-32-character-random-secret
PHOENIX_ADMIN_INITIAL_PASSWORD=ReplaceWithStrongAdminPassword1!
PHOENIX_PORT=6006
PHOENIX_OTLP_PORT=4317
PHOENIX_PROJECT_NAME=datalogue-production

# 首次启动 Phoenix 后，由管理员创建 datalogue-otel-writer system key 并填入。
PHOENIX_SYSTEM_API_KEY=
AGENTSCOPE_OTEL_TRACING_ENABLED=true
AGENTSCOPE_OTEL_EXPORTER_ENABLED=false
AGENTSCOPE_OTEL_EXPORTER_INSECURE=true
