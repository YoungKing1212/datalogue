# Database
DATABASE_URL=postgresql://datalogue:datalogue@localhost:5432/datalogue

# LLM fallback
# 前端 /api/llm 数据库配置优先；未配置或角色未绑定时回退到这里。
OPENAI_API_KEY=your-openai-compatible-api-key
OPENAI_BASE_URL=https://api.minimaxi.com/v1
OPENAI_PROXY_URL=
LLM_MODEL=MiniMax-M2.7
LLM_TIMEOUT_SECONDS=60

# Security
SECRET_KEY=your-secret-key-change-this-in-production
AES_KEY=your-32-byte-aes-key-here!!

# App
APP_ENV=development
LOG_LEVEL=INFO

# Langfuse observability (Python SDK v4)
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PROJECT_ID=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENVIRONMENT=dev
LANGFUSE_RELEASE=local
LANGFUSE_PROMPT_LABEL=production
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_FLUSH_AT_END=true
LANGFUSE_MAX_TEXT_LENGTH=4000

# Langfuse 本地 Docker Compose PostgreSQL
# 默认与业务库共用 datalogue_pgdata 卷中的同一个 PostgreSQL 实例，但使用独立 database。
LANGFUSE_POSTGRES_USER=langfuse
LANGFUSE_POSTGRES_PASSWORD=langfuse
LANGFUSE_POSTGRES_DB=langfuse

# 多轮问数
MULTITURN_ENABLED=false
MULTITURN_LOCK_TTL_SECONDS=300
MULTITURN_COMPACTION_ENABLED=false
MULTITURN_COMPACTION_TOKEN_THRESHOLD=8000
MULTITURN_BLUEPRINT_SHORTCUT_ENABLED=false
MULTITURN_LAST_SUCCESS_TASK_MAX_TOKENS=2000
MULTITURN_ARTIFACT_CACHE_TTL_SECONDS=1800
MULTITURN_REFINEMENT_FAST_PATH_ENABLED=false
MULTITURN_RESULT_LOCAL_FILTER_ENABLED=false
MULTITURN_SQL_AST_PATCH_ENABLED=false

# 查询结果产物
QUERY_ARTIFACT_TTL_SECONDS=604800
QUERY_ARTIFACT_MAX_BYTES=2097152
QUERY_ARTIFACT_CLEANUP_INTERVAL_SECONDS=300
QUERY_ARTIFACT_CLEANUP_BATCH_SIZE=500

# SubAgent 运行与规划
SUBAGENT_FANOUT_MAX_PARALLEL=3
SUBAGENT_RUNNER_MODE=in_process
SUBAGENT_REMOTE_BASE_URL=
SUBAGENT_REMOTE_API_KEY=
SUBAGENT_REMOTE_TIMEOUT_SECONDS=60
SUBAGENT_REMOTE_RETRIES=0
SUBAGENT_PLANNER_DETAIL_LOOP_ENABLED=false
SUBAGENT_PLANNER_DETAIL_MAX_ROUNDS=3
SUBAGENT_PLANNER_DETAIL_MAX_REQUESTS_PER_ROUND=5
SUBAGENT_PLANNER_FIELD_SEARCH_DEFAULT_TOP_K=30
SUBAGENT_PLANNER_FIELD_SEARCH_MAX_TOP_K=50
SUBAGENT_PLANNER_TABLE_FULL_FIELD_LIMIT=120
SUBAGENT_PLANNER_TABLE_COMPACT_FIELD_LIMIT=300

# LeadAgent 渐进式资产注入
LEAD_AGENT_PLANNER_USE_PROJECTION=false
LEAD_AGENT_ENABLE_DATASET_FANOUT=false
LEAD_AGENT_USE_PROGRESSIVE_ASSETS=false
LEAD_AGENT_PROGRESSIVE_ASSET_TOPK_BLUEPRINT=3
LEAD_AGENT_PROGRESSIVE_ASSET_TOPK_METRIC=5
LEAD_AGENT_PROGRESSIVE_ASSET_TOPK_DIMENSION=5
LEAD_AGENT_PROGRESSIVE_ASSET_TOPK_TERM=5
LEAD_AGENT_PROGRESSIVE_ASSET_TOPK_FIELD=10
LEAD_AGENT_PROGRESSIVE_ASSET_TOPK_TABLE=8
LEAD_AGENT_PROGRESSIVE_ASSET_MIN_CONFIDENCE_BLUEPRINT=0.60
LEAD_AGENT_PROGRESSIVE_ASSET_MIN_CONFIDENCE_METRIC=0.35
LEAD_AGENT_PROGRESSIVE_ASSET_MIN_CONFIDENCE_DIMENSION=0.35
LEAD_AGENT_PROGRESSIVE_ASSET_MIN_CONFIDENCE_TERM=0.30
LEAD_AGENT_PROGRESSIVE_ASSET_MIN_CONFIDENCE_FIELD=0.25
LEAD_AGENT_PROGRESSIVE_ASSET_MIN_CONFIDENCE_TABLE=0.25
LEAD_AGENT_PROGRESSIVE_ASSET_TOKEN_BUDGET_SKILL_SELECTION=600
LEAD_AGENT_PROGRESSIVE_ASSET_TOKEN_BUDGET_TOOL_PLANNING=800
LEAD_AGENT_PROGRESSIVE_ASSET_GLOBAL_MIN_CONFIDENCE=0.20
LEAD_AGENT_PROGRESSIVE_ASSET_METADATA_WHITELIST=table_name,column_name,parameters,expr
LEAD_AGENT_PROGRESSIVE_ASSET_MAX_SIGNALS_PER_ASSET=3

# 数据集路由与上下文裁剪
DATASET_ROUTER_AUTO_SELECT_THRESHOLD=0.65
DATASET_ROUTER_AUTO_SELECT_MARGIN=0.12
DATASET_ROUTER_MAX_CANDIDATES=3
SUBAGENT_LLM_VISIBLE_TOKEN_BUDGET=200
DATASET_CONTEXT_TOKEN_BUDGET=4000
SUBAGENT_CANDIDATE_ASSET_CONTEXT_TOKEN_BUDGET=2500
SUBAGENT_PLANNER_PROMPT_ASSET_LIMIT=40
SUBAGENT_PLANNER_PROMPT_TEXT_LIMIT=120
SUBAGENT_PLANNER_PROMPT_LIST_LIMIT=20
SUBAGENT_PLANNER_PUBLIC_TEXT_LIMIT=240
SUBAGENT_PLANNER_PUBLIC_LIST_LIMIT=12
LEAD_AGENT_PLANNER_PROJECTION_MAX_PRIOR_TURNS=3
LEAD_AGENT_PLANNER_PROJECTION_MAX_TEXT_CHARS=240
LEAD_AGENT_PLANNER_PROJECTION_MAX_PRIOR_BRIEF_CHARS=360
ANSWER_EXPLANATION_LOW_CONFIDENCE_THRESHOLD=0.75
REPORT_RESULT_MAX_ROWS=30
REPORT_CELL_MAX_CHARS=120
SQL_MAX_RETRY_COUNT=3
DSL_FIELD_CATALOG_LIMIT=20
